# ═══════════════════════════════════════════════════════════
#  MONITORING SYSTEM, variáveis de ambiente
#  Copie para .env e preencha. O .env nunca entra no Git.
# ═══════════════════════════════════════════════════════════

# ─── Servidor ────────────────────────────────────────────────
# Por padrão escuta apenas no loopback. Em container, o Dockerfile
# define HOST=0.0.0.0 porque lá a rede já é isolada.
HOST=127.0.0.1
PORT=3001
NODE_ENV=development

# Origens do frontend liberadas no CORS, separadas por vírgula.
# Atrás do nginx a API é servida na mesma origem e isto pode ficar vazio.
CORS_ORIGIN=http://localhost:5175,http://127.0.0.1:5175

# Só ative com um proxy confiável na frente (nginx). Ligado sem proxy,
# permitiria burlar o rate limit forjando o cabeçalho X-Forwarded-For.
TRUST_PROXY=false

# Exigido para limpar o histórico de alertas em produção.
ADMIN_TOKEN=

# ─── OpenWeatherMap (clima, qualidade do ar, geocodificação) ──
# Sem esta chave o sistema roda em modo demo, com dados simulados.
OWM_KEY=

# ─── Stadia Maps (mapa sísmico) ──────────────────────────────
STADIA_KEY=

# ─── Onde fica o histórico de alertas ────────────────────────
# Padrão: backend/data. No Docker é um volume montado em /data.
DATA_DIR=
ALERTS_MAX_ENTRIES=5000
# Janela em que um mesmo alerta não é gravado de novo, para o polling
# não encher o histórico de duplicatas.
ALERTS_DEDUPE_WINDOW_MS=1800000

# ─── Limites de requisição (por janela, por IP) ──────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GLOBAL=300
RATE_LIMIT_UPSTREAM=60
RATE_LIMIT_SEARCH=30
RATE_LIMIT_WRITE=10

# ─── Cache de resposta (em milissegundos) ────────────────────
CACHE_TTL_WEATHER_MS=120000
CACHE_TTL_FORECAST_MS=600000
CACHE_TTL_AQI_MS=600000
CACHE_TTL_SEISMIC_MS=180000
CACHE_TTL_GEOCODE_MS=3600000

# ─── Chamadas às APIs externas ───────────────────────────────
UPSTREAM_TIMEOUT_MS=8000
UPSTREAM_MAX_BYTES=25165824

# ─── Alertas por e-mail (Nodemailer) ─────────────────────────
ALERT_EMAILS_ENABLED=true
EMAIL_FROM=
EMAIL_TO=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_DEBOUNCE_MS=600000

# Limites do servidor para disparar e-mail. São deliberadamente separados
# dos limites do painel: o cliente controla o que vê, o servidor controla
# o que sai pela caixa postal.
EMAIL_TEMP_MIN=0
EMAIL_TEMP_MAX=38
EMAIL_MAG_THRESHOLD=6

# ─── Log ─────────────────────────────────────────────────────
LOG_LEVEL=info

# Assistente ColodelBot (Google AI Studio). Sem chave o recurso fica oculto
# na interface em vez de aparecer quebrado.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Mensagens por minuto por IP no assistente, a rota mais cara do sistema.
RATE_LIMIT_ASSISTANT=12

# Consultas ao historico gravado em disco. Custam pouco para quem pede e
# muito para quem responde, entao tem teto proprio em vez de herdar o global.
RATE_LIMIT_HISTORY=40

# Acesso de fora do loopback. Sem ACCESS_PASSWORD o modo servido recusa subir.
ACCESS_USER=monitor
ACCESS_PASSWORD=

# O backend serve o build do frontend, colocando pagina e API na mesma origem.
SERVE_STATIC=false
# STATIC_DIR=../frontend/dist

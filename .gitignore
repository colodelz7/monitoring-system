# Dependências
node_modules/

# Segredos e configuração local
.env
.env.*
!.env.example

# Estado de execução: o histórico de alertas é dado do sistema, não código.
# Ele vive em DATA_DIR (backend/data por padrão) e é montado como volume no
# Docker, justamente para nunca entrar no repositório.
backend/data/
backend/alerts_log.json
backend/alerts_log.json.migrado

# Artefatos de build
dist/
build/

# Logs e temporários
*.log
*.tmp
.DS_Store
Thumbs.db

# Editores
.vscode/
.idea/

# Worker do MapLibre, copiado de node_modules por scripts/copy-maplibre-worker.mjs
frontend/public/maplibre/

# Arquivos de entrada do usuario, nao fazem parte do codigo
arquivos/
